#!/bin/sh

# Status bar module for the VPN-routed torrent stack (torrent-ns).
# Shows per-torrent-state counts, aggregate down/up speed, and whether
# the WireGuard tunnel used for torrenting actually has a live handshake.
#
# Transmission lives inside the torrent-ns network namespace, reachable
# from the host only via the veth address below (not localhost).

NETNS="torrent-ns"
TR_HOST="10.200.200.2:9091"
WG_IF="protonvpn"

case $BLOCK_BUTTON in
	1) setsid -f "$TERMINAL" -e tremc -X ;;
	2) td-toggle ;;
	3) notify-send "🌱 Torrent module" "\- Left click to open tremc.
- Middle click to toggle transmission.
- Scroll up to add magnet link from clipboard.
- Shift click to edit script.
Shows per-torrent state counts, then total down/up speed,
then VPN tunnel status for torrenting:
🛑 paused  🕰 idle (no peers)  ⏳ queued  🔽 downloading  🔃 up & down  ✅ done  🌱 seeding
Down/up after that is total speed (↓/↑, plain arrows).
🔒 VPN tunnel up   🔓 VPN tunnel down/stale   ⛔ transmission not running" ;;
	4)
		magnet="$(xsel --clipboard --output)"
		case "$magnet" in
			magnet:\?*)
				transmission-remote "$TR_HOST" -a "$magnet" >/dev/null 2>&1 &&
					notify-send "🌱 Torrent added" "$magnet" ||
					notify-send "🌱 Torrent add failed" "$magnet"
				;;
			*) notify-send "🌱 Torrent add failed" "Clipboard has no magnet link" ;;
		esac
		;;
	6) "$TERMINAL" -e "$EDITOR" "$0" ;;
esac

rpc() {
	sid="$(curl -s -m 2 -D - "http://${TR_HOST}/transmission/rpc/" -o /dev/null 2>/dev/null |
		awk -F': ' 'BEGIN{IGNORECASE=1} /X-Transmission-Session-Id/{print $2}' | tr -d '\r')"
	[ -n "$sid" ] || return 1
	curl -s -m 2 -H "X-Transmission-Session-Id: ${sid}" "http://${TR_HOST}/transmission/rpc/" -d "$1"
}

stats="$(rpc '{"method":"session-stats"}')"
if [ -z "$stats" ]; then
	printf "⛔ torrent stack down\n"
	exit
fi

states="$(transmission-remote "$TR_HOST" -l 2>/dev/null | grep -E "^ *[0-9]+ " |
	sed " # The letters are for sorting and will not appear.
	s/.*Stopped.*/A 🛑/;
	s/.*Seeding.*/Z 🌱/;
	s/.*100%.*/N ✅/;
	s/.*Idle.*/B 🕰/;
	s/.*Queued.*/C ⏳/;
	s/.*Up & Down.*/E 🔃/;
	s/.*Downloading.*/D 🔽/;
	s/^ *[0-9].*/Y ❓/" |
		sort -h | uniq -c | awk '{print $3 $1}' | paste -sd ' ' -)"

speeds="$(printf '%s' "$stats" | jq -r '"\(.arguments.downloadSpeed) \(.arguments.uploadSpeed)"' |
	awk '{
		split("B K M G", u)
		down = $1; up = $2
		di = 1; while (down >= 1024 && di < 4) { down /= 1024; di++ }
		ui = 1; while (up   >= 1024 && ui < 4) { up   /= 1024; ui++ }
		printf "↓%.1f%s ↑%.1f%s", down, u[di], up, u[ui]
	}')"

hs="$(sudo ip netns exec "$NETNS" wg show "$WG_IF" latest-handshakes 2>/dev/null | awk '{print $2}')"
now="$(date +%s)"
if [ -n "$hs" ] && [ "$hs" -gt 0 ] 2>/dev/null && [ $(( now - hs )) -lt 180 ]; then
	vpn="🔒"
else
	vpn="🔓"
fi

printf "%s %s %s\n" "$states" "$speeds" "$vpn"
