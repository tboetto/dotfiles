#!/bin/sh

[[ $(hostname) == *"desktop"* ]] && ISDESKTOP=true || ISDESKTOP=false;
[[ $(hostname) == *"laptop"* ]] && ISLAPTOP=true || ISLAPTOP=false;

$ISLAPTOP && xrandr --auto &	# laptop only: on the desktop, trimonarr sets the layout and --auto would race it, putting the S9 at 4K
xrandr --dpi 220 &
xrdb -merge "${XDG_CONFIG_HOME:-$HOME/.config}/x11/xresources"

dwmblocks &

rbg &

pipewire &

if $ISLAPTOP; then
	remaps &
elif $ISDESKTOP; then
	remaps &
	trimonarr &
	# The S9 (USB-C) doesn't wake after DPMS sleep, so DPMS stays off and idle only locks
	# (xsecurelock) and runs an xscreensaver hack. Idle after 600s, dimmer warns for 5s.
	xset -dpms
	xset s 600 5
	xset s noblank
	xss-lock -n /usr/lib/xsecurelock/dimmer -l -- lockscreen &
fi

autostart="xcompmgr dunst unclutter"

for program in $autostart; do
	pidof -s "$program" || "$program" &
done >/dev/null 2>&1

pkill -SIGUSR1 dwmblocks
