#!/bin/bash
# remaps          apply keyboard settings once
# remaps watch    apply now, then again whenever the external keyboard is plugged or unplugged
#
# The TMK FC980C (feed:980c) is the desktop's keyboard and does its own caps/ctrl
# remapping in firmware. While it is plugged into the laptop, the laptop acts like the
# desktop: the laptop branch below is skipped, and /etc/keyd/default.conf excludes
# feed:980c so keyd leaves it alone. Unplugged, the laptop branch is back.

ext_kb() { grep -q 'Vendor=feed Product=980c' /proc/bus/input/devices; }

apply() {
    if [[ $(hostname) == *"laptop"* ]] && ! ext_kb; then ISLAPTOP=true; else ISLAPTOP=false; fi

    # Laptop: shorter delay + faster rate to match macOS (InitialKeyRepeat/KeyRepeat)
    if $ISLAPTOP; then
        xset r rate 150 66
    else
        xset r rate 300 50
    fi

    if $ISLAPTOP; then
        # Caps (tap = Esc, hold = Ctrl) is done by keyd, below X, so xcape and the
        # per-device `setxkbmap -device` are gone: keyd grabs the real keyboard and
        # X only sees its virtual one. /etc/keyd/default.conf also sends the
        # physical left ctrl as F13 (evdev 183, X keycode 191); make that Hyper.
        xmodmap -e 'keycode 191 = Hyper_L' -e 'add mod3 = Hyper_L'
    fi
}

if [[ $1 == watch ]]; then
    # Only act when the keyboard's presence changes: input hotplug fires many events
    # (keyd's virtual devices included), and applying settings can trigger more.
    last=unset
    handle() {
        ext_kb && now=ext || now=none
        [[ $now == "$last" ]] && return
        apply && last=$now
    }
    handle
    udevadm monitor --udev --subsystem-match=input | while read -r _; do
        sleep 1	# let X pick up the new device before its settings are applied
        handle
    done
else
    apply
fi
