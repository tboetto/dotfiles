#!/bin/bash

[[ $(hostname) == *"laptop"* ]] && ISLAPTOP=true || ISLAPTOP=false;

# Laptop: shorter delay + faster rate to match macOS (InitialKeyRepeat/KeyRepeat)
if $ISLAPTOP; then
    xset r rate 150 66
else
    xset r rate 300 50
fi

if $ISLAPTOP; then
    # Caps (tap = Esc, hold = Ctrl) is done by keyd, below X, so xcape and the
    # per-device `setxkbmap -device` are gone: keyd grabs the real keyboard and
    # X only sees its virtual one. /etc/keyd/default.conf also sends the
    # physical left ctrl as F13 (evdev 183, X keycode 191); make that Hyper.
    xmodmap -e 'keycode 191 = Hyper_L' -e 'add mod3 = Hyper_L'
fi
