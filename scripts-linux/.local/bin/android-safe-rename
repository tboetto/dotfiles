#!/usr/bin/env python3
"""Rename files and directories under a directory to be Android-storage-safe (strip : < > " \\ | ? *),
patching any .cue sidecar's FILE reference to match. Safe to re-run repeatedly."""
import os
import re
import sys

FORBIDDEN_RE = re.compile(r'[:<>"\\|?*]')


def sanitize(name: str) -> str:
    name = name.replace(": ", " - ")
    return FORBIDDEN_RE.sub("-", name)


def main() -> None:
    args = [a for a in sys.argv[1:] if a != "--apply"]
    root = args[0] if args else "."
    dry_run = "--apply" not in sys.argv

    renames = []
    # Bottom-up: a directory is renamed only after everything inside it, so
    # every path we rename is still valid when we get to it. The root is kept.
    for dirpath, dirnames, filenames in os.walk(root, topdown=False):
        for name in filenames + dirnames:
            new_name = sanitize(name)
            if new_name != name:
                renames.append((dirpath, name, new_name))

    by_dir = {}
    for dirpath, old, new in renames:
        by_dir.setdefault(dirpath, []).append((old, new))

    # dict preserves insertion order, which is the bottom-up walk order
    for dirpath, pairs in by_dir.items():
        mapping = dict(pairs)
        # patch every .cue here, even one whose own name is already clean
        for cue in sorted(os.listdir(dirpath)):
            if cue.lower().endswith(".cue"):
                cue_path = os.path.join(dirpath, cue)
                if not os.path.isfile(cue_path):
                    continue
                with open(cue_path, encoding="utf-8", errors="replace") as f:
                    content = f.read()
                new_content = content
                for old_name, new_name in mapping.items():
                    new_content = new_content.replace(f'"{old_name}"', f'"{new_name}"')
                if new_content != content:
                    print(f'{"[DRY] " if dry_run else ""}Updating FILE ref in {cue_path}')
                    if not dry_run:
                        with open(cue_path, "w", encoding="utf-8") as f:
                            f.write(new_content)
        for old, new in pairs:
            old_path, new_path = os.path.join(dirpath, old), os.path.join(dirpath, new)
            if os.path.lexists(new_path):
                print(f"SKIP (target exists): {old_path} -> {new_path}")
                continue
            print(f'{"[DRY] " if dry_run else ""}Rename: {old_path} -> {new_path}')
            if not dry_run:
                os.rename(old_path, new_path)

    print(f"\n{len(renames)} files {'would be' if dry_run else ''} renamed.")
    if dry_run:
        print("Re-run with --apply to actually rename.")


if __name__ == "__main__":
    main()
